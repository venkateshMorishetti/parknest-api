# Copy to .env (never commit .env). Values for the testing and production servers go in their secret settings.
SPRING_PROFILES_ACTIVE=local            # local | testing | production
DATABASE_URL=jdbc:postgresql://localhost:5432/parknest_local
DATABASE_USERNAME=parknest
DATABASE_PASSWORD=parknest
JWT_SECRET=                             # 32+ random characters (openssl rand -base64 48)
OTP_PEPPER=                             # random string, different per environment
OTP_FIXED_CODE=                         # local/testing only, e.g. 123456. Empty = random codes
GOOGLE_CLIENT_ID=                       # web client id from Google Cloud console
CORS_ALLOWED_ORIGINS=http://localhost:4200
